# ── Vendor sign-up email delivery (Resend) ─────────────────────
# Without RESEND_API_KEY the form still succeeds and logs a warning —
# leads are never dropped because email is unconfigured.
RESEND_API_KEY=
KOSH_FROM_EMAIL="KOSH <hello@kosh.ca>"
KOSH_TEAM_EMAIL=vendors@kosh.ca

# ── Optional lead log (Google Sheet / Notion / Zapier webhook) ──
VENDOR_SIGNUP_WEBHOOK_URL=

# ── Analytics ──────────────────────────────────────────────────
# Google Tag Manager container. Leave blank to skip the GTM snippet entirely.
NEXT_PUBLIC_GTM_ID=
